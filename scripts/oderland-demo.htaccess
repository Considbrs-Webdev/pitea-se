AuthType Basic
AuthName "Piteå Municipio 7 demo"
AuthUserFile /home/considbrs/domains/.htpasswd
Require valid-user

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Missing local uploads are fetched from production.
# Replace MEDIAUSER:MEDIAPASS with the basic-auth account for that origin.
# URL-encode any special characters in the password.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^wp-content/uploads/(.*)$ https://MEDIAUSER:MEDIAPASS@www.pitea.se/wp-content/uploads/$1 [P,L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
